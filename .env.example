DIRECTIVEGUARD_ADDRESS=:8080
DIRECTIVEGUARD_BASE_URL=http://localhost:8080
DIRECTIVEGUARD_DATABASE=directiveguard-cloud.db
# Generate with: openssl rand -base64 32
DIRECTIVEGUARD_SESSION_SECRET=

# GitHub OAuth App callback: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe is disabled unless all three values are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=
STRIPE_PORTAL_CONFIG_ID=
